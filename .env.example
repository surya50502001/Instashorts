# Database Configuration
DatabaseProvider=PostgreSql
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=scrollguardian;Username=postgres;Password=postgres

# Security & JWT Token Authentication
Jwt__SecretKey=ScrollGuardian_SuperSecretKey_ProductionGrade_2026_Minimum32Characters!
Jwt__Issuer=ScrollGuardianApi
Jwt__Audience=ScrollGuardianClient
Jwt__ExpiryMinutes=120
Jwt__RefreshTokenDays=30

# AI Provider Configuration (Auto, Gemini, OpenAI, RuleBased)
AI__Provider=Auto
AI__GeminiApiKey=your_gemini_api_key_here
AI__Model=gemini-1.5-flash

# Stripe Subscriptions & Billing
Stripe__SecretKey=your_stripe_secret_key_here
Stripe__PublishableKey=your_stripe_publishable_key_here

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
EnableSwaggerInProd=true
